    if ffActive then
        ffStatus.Text = "On"
        ffStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
        if player.Character and not player.Character:FindFirstChildOfClass("ForceField") then
            Instance.new("ForceField", player.Character)
        end
    else
        ffStatus.Text = "Off"
        ffStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
        if player.Character then
            local ff = player.Character:FindFirstChildOfClass("ForceField")
            if ff then ff:Destroy() end
        end
    end
end)

