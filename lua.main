local btnSkybox = createButton("SetSkybox", "Set\nSkybox", UDim2.new(0, 80, 0, 70), UDim2.new(0, 5, 0, 5), topLeft)
local btnDecal = createButton("DecalSpam", "Decal\nSpam", UDim2.new(0, 80, 0, 70), UDim2.new(0, 93, 0, 5), topLeft)
local txtTexture = createTextBox("IDHere", "ID Here", "Change Texture", UDim2.new(0, 80, 0, 55), UDim2.new(0, 181, 0, 5), topLeft)

local btnJumpscare = createButton("JumpScare", "Jump\nScare", UDim2.new(0, 80, 0, 70), UDim2.new(0, 5, 0, 85), topLeft)
local btnParticle = createButton("ParticleSpam", "Particle\nSpam", UDim2.new(0, 80, 0, 70), UDim2.new(0, 93, 0, 85), topLeft)
local txtParticleSize = createTextBox("SizeHere", "Size Here", "Change Particle Size", UDim2.new(0, 80, 0, 55), UDim2.new(0, 181, 0, 85), topLeft)

local function getTextureID() return tonumber(txtTexture.Text) or 0 end
local function getParticleSize() return tonumber(txtParticleSize.Text) or 2 end

btnSkybox.MouseButton1Click:Connect(function()
	local SKY_ID = getTextureID(); local Lighting = game:GetService("Lighting"); local sky = Lighting:FindFirstChild("Sky") or Instance.new("Sky", Lighting); sky.SkyboxBk = "rbxassetid://" .. SKY_ID; sky.SkyboxDn = "rbxassetid://" .. SKY_ID; sky.SkyboxFt = "rbxassetid://" .. SKY_ID; sky.SkyboxLf = "rbxassetid://" .. SKY_ID; sky.SkyboxRt = "rbxassetid://" .. SKY_ID; sky.SkyboxUp = "rbxassetid://" .. SKY_ID
end)

btnDecal.MouseButton1Click:Connect(function()
	local DECAL_ID = getTextureID(); for _, obj in pairs(Workspace:GetDescendants()) do if obj:IsA("BasePart") then local faces = {"Front", "Back", "Bottom", "Top", "Left", "Right"}; for _, face in pairs(faces) do local decal = Instance.new("Decal"); decal.Face = Enum.NormalId[face]; decal.Texture = "rbxassetid://" .. DECAL_ID; decal.Parent = obj end end end
end)

btnParticle.MouseButton1Click:Connect(function()
	local PARTICLE_ID = getTextureID(); local pSize = getParticleSize(); for _, v in pairs(Workspace:GetDescendants()) do if v:IsA("BasePart") then local p = Instance.new("ParticleEmitter", v); p.Texture = "rbxassetid://" .. PARTICLE_ID; p.Rate = 50; p.Size = NumberSequence.new(pSize) end end
end)

btnJumpscare.MouseButton1Click:Connect(function()
	local image = tostring(getTextureID()); local sound = "1843405374"; local seconds = 8; local speed = 1; local start = 0; local volume = 10; local jumpscare = Instance.new("ScreenGui"); jumpscare.ZIndexBehavior = Enum.ZIndexBehavior.Sibling; jumpscare.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"); local label = Instance.new("ImageLabel", jumpscare); label.BackgroundColor3 = Color3.fromRGB(255, 255, 255); label.BorderColor3 = Color3.fromRGB(0, 0, 0); label.BorderSizePixel = 0; label.Size = UDim2.new(1, 0, 1, 0); label.Image = "rbxassetid://"..image; local audio = Instance.new("Sound", game.SoundService); audio.SoundId = "rbxassetid://"..sound; audio.PlaybackSpeed = speed; audio.TimePosition = start; audio.Volume = volume; audio:Play(); task.wait(seconds); jumpscare:Destroy()
end)

