local colorRGBs = {
    ["Red"] = Color3.fromRGB(255, 0, 0),
    ["Blue"] = Color3.fromRGB(13, 105, 172),
    ["Green"] = Color3.fromRGB(75, 151, 75),
    ["Yellow"] = Color3.fromRGB(245, 205, 48),
    ["Purple"] = Color3.fromRGB(107, 50, 124),
    ["Maroon Red"] = Color3.fromRGB(117, 0, 0),
    ["Dark Blue"] = Color3.fromRGB(0, 16, 176),
    ["Dark Green"] = Color3.fromRGB(40, 127, 71),
    ["Brown"] = Color3.fromRGB(124, 92, 70),
    ["White"] = Color3.fromRGB(255, 255, 255)
}

local selectedFireColor = colorRGBs["Red"]
local fireActive = false

local function applyFireSystem()
    local Players = game:GetService("Players"); local LP = Players.LocalPlayer;
    local character = LP.Character or LP.CharacterAdded:Wait(); local fireColor = selectedFireColor; if character then for _, v in pairs(character:GetChildren()) do if v:IsA("BasePart") then if not v:FindFirstChild("sp0okyFire") then local f = Instance.new("Fire"); f.Name = "sp0okyFire"; f.Color = fireColor; f.SecondaryColor = fireColor; f.Size = 5; f.Parent = v end end end end
end

local function removeFireSystem()
    local character = player.Character
    if character then
        for _, v in pairs(character:GetChildren()) do
            if v:IsA("BasePart") then
                local existingFire = v:FindFirstChild("sp0okyFire")
                if existingFire then existingFire:Destroy() end
            end
        end
    end
end

fireStatus.MouseButton1Click:Connect(function()
    fireActive = not fireActive
    if fireActive then
        fireStatus.Text = "On"
        fireStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
        applyFireSystem()
    else
        fireStatus.Text = "Off"
        fireStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
        removeFireSystem()
    end
end)

local colorGridFrame = Instance.new("Frame")
colorGridFrame.Size = UDim2.new(0, 268, 0, 50)
colorGridFrame.Position = UDim2.new(0, 5, 0, 90)
colorGridFrame.BackgroundTransparency = 1
colorGridFrame.Parent = bottomRight

local colorsRow1 = {"Red", "Blue", "Green", "Yellow", "Purple"}
local colorsRow2 = {"Maroon Red", "Dark Blue", "Dark Green", "Brown", "White"}

local function createColorBtn(text, x, y)
    local cBtn = Instance.new("TextButton")
    cBtn.Size = UDim2.new(0, 50, 0, 22)
    cBtn.Position = UDim2.new(0, x * 54, 0, y * 25)
    cBtn.Text = text
    cBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    cBtn.TextSize = 11
    cBtn.Font = Enum.Font.SourceSans
    cBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    cBtn.BorderColor3 = Color3.fromRGB(255, 69, 0)
    cBtn.BorderSizePixel = 1
    cBtn.Parent = colorGridFrame

    cBtn.MouseButton1Click:Connect(function()
        if colorRGBs[text] then
            selectedFireColor = colorRGBs[text]
            if fireActive and player.Character then
                for _, v in pairs(player.Character:GetChildren()) do
                    if v:IsA("BasePart") then
                        local f = v:FindFirstChild("sp0okyFire")
                        if f and f:IsA("Fire") then
                            f.Color = selectedFireColor
                            f.SecondaryColor = selectedFireColor
                        end
                    end
                end
            end
        end
    end)
end

for i, name in ipairs(colorsRow1) do createColorBtn(name, i-1, 0) end
for i, name in ipairs(colorsRow2) do createColorBtn(name, i-1, 1) end
