btnChangeTitle.MouseButton1Click:Connect(function()
    local CustomTitle = titleBox.Text ~= "" and titleBox.Text or "Custom Title";
    local Players = game:GetService("Players"); local LocalPlayer = Players.LocalPlayer;
    local function applyBillboard(character) local head = character:WaitForChild("Head", 10); if not head then return end; local existing = head:FindFirstChild("SpookyBillboard"); if existing then existing:Destroy() end; local bbg = Instance.new("BillboardGui"); bbg.Name = "SpookyBillboard"; bbg.Size = UDim2.new(0, 200, 0, 50); bbg.StudsOffset = Vector3.new(0, 2.5, 0); bbg.AlwaysOnTop = true; bbg.Parent = head; local tl = Instance.new("TextLabel"); tl.Size = UDim2.new(1, 0, 1, 0); tl.Text = CustomTitle; tl.TextColor3 = Color3.fromRGB(255, 102, 0); tl.BackgroundTransparency = 1; tl.TextSize = 45; tl.Font = Enum.Font.SourceSansBold; tl.Parent = bbg end; if LocalPlayer.Character then applyBillboard(LocalPlayer.Character) end; LocalPlayer.CharacterAdded:Connect(applyBillboard)
end)

btnChangeName.MouseButton1Click:Connect(function()
    local Sp0okyName = nameBox.Text ~= "" and nameBox.Text or "Custom Name"; local Players = game:GetService("Players"); local localPlayer = Players.LocalPlayer; localPlayer.Name = Sp0okyName; localPlayer.DisplayName = Sp0okyName; local function updateHumanoid(character) local humanoid = character:WaitForChild("Humanoid", 5); if humanoid then humanoid.DisplayName = Sp0okyName end end; if localPlayer.Character then updateHumanoid(localPlayer.Character) end; localPlayer.CharacterAdded:Connect(updateHumanoid)
end)

